{
  "name": "winterland",
  "private": true,
  "version": "0.9.1",
  "description": "Winterland — a 3D isometric arcade-idle lumber mill game (Three.js + TypeScript + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "playtest": "node scripts/playtest.mjs",
    "desktop": "npm run build && electron .",
    "package:desktop": "node scripts/package-desktop.mjs",
    "package:linux": "node scripts/package-desktop.mjs linux-x64 linux-arm64",
    "package:win": "node scripts/package-desktop.mjs win32-x64",
    "package:mac": "node scripts/package-desktop.mjs darwin-arm64 darwin-x64",
    "test": "vitest run",
    "soak": "node scripts/soak.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "electron": "44.7.2",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "main": "desktop/main.cjs"
}
